# ─────────────────────────────────────────────────────────────────────────────
# Sonora — copie este arquivo para `.env` e preencha os valores.
# O `.env` NUNCA vai para o repositorio (ja esta no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Porta do servidor web. WEB_PORT tem prioridade sobre PORT (o Geno sobrescreve
# PORT com 5432, a porta do Postgres). No Render, nao defina WEB_PORT: ele
# define PORT sozinho.
WEB_PORT=8000

NODE_ENV=development
APP_TITULO=Sonora

# ─── Banco de dados (Postgres do Supabase) ───────────────────────────────────
# No painel do Supabase: botao "Connect" > "Session pooler" > copie a URI e troque
# [YOUR-PASSWORD] pela senha do banco (redefinivel em Database > Settings).
#   postgresql://postgres.<ref>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:5432/postgres
# Use o Session pooler (porta 5432): o modo transacao (porta 6543) nao serve, e a
# conexao direta (db.<ref>.supabase.co) so funciona em rede com IPv6.
# Senha com @ : / # precisa ir codificada na URL. Nao acrescente ?sslmode=.
# As chaves publishable/secret do Supabase NAO sao usadas: o app fala Postgres.
DATABASE_URL=
# Schema proprio, fora do `public` que o Supabase expoe pela Data API.
APP_SCHEMA=sonora
# O Supabase aceita SSL; deixe "require".
DATABASE_SSL=require

# ─── Modo demonstracao (apoio temporario, nao faz parte da versao alvo) ──────
# Use SOMENTE para ver a interface sem banco disponivel. Monta em memoria o
# acervo inicial (com capas reais), pessoas, escutas, notas, reviews e listas
# ficticias, e libera o acesso com leo / demo1234. Nada e' persistido.
# Ignorado automaticamente se DATABASE_URL estiver preenchida ou se
# NODE_ENV=production — ou seja, nunca vale em producao.
DEMO_MODE=false

# ─── Fonte externa de metadados ───────────────────────────────────────────────
# O MusicBrainz exige que a aplicacao se identifique com um contato no
# User-Agent. Sem isso, o servico pode recusar as requisicoes.
MUSICBRAINZ_CONTACT=

# ─── Sessao e primeiro acesso ─────────────────────────────────────────────────
# String aleatoria longa. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Primeiro administrador, criado automaticamente na primeira subida com banco.
# Qualquer pessoa pode criar a propria conta pela tela de entrada, mas entra
# como usuario comum: o perfil de administrador vem daqui ou de outro admin.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=
# Opcional. Sem valor, o admin nasce com <usuario>@sonora.invalid.
ADMIN_BOOTSTRAP_EMAIL=

# ─── Outros ───────────────────────────────────────────────────────────────────
# Origens externas permitidas (CORS). Vazio = ninguem de fora. Separe por virgula.
CORS_ORIGINS=
